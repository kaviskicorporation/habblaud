# Fork Kaviski: configuração do LiveKit. Copie para livekit.yaml e troque a chave e o segredo
# (segredo com 32+ caracteres: openssl rand -base64 48). Os mesmos valores vão no .env do Habblaud:
# HABBLAUD_LIVEKIT_KEY / HABBLAUD_LIVEKIT_SECRET. Este arquivo com valores reais NUNCA vai ao git.
port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  # No VPS: o IP público. Na VM da rede local: o IP da VM (192.168.1.220).
  node_ip: 31.97.27.13
  use_external_ip: false
keys:
  TROQUE_A_CHAVE: TROQUE_O_SEGREDO_COM_32_OU_MAIS_CARACTERES
logging:
  level: info
